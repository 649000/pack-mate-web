# Non-secret values for running the app against the local Supabase stack.
#
# Loaded by playwright.config.ts so unauthenticated end-to-end tests exercise the
# built output against the local stack and write no production data. The local
# keys below are the deterministic Supabase CLI development defaults, not secrets.
#
# Firebase values are intentionally omitted: the identity project is shared with
# production for now, so the committed defaults in lib/public-config.ts apply.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
